(version 1)

(rule r0
  (layer F.Cu)
  (condition "B.Type != 'pad'")
  (constraint hole_to_hole (min 53.5mil))
  (severity exclusion)
)

(rule r1
  (condition "A.Type == 'pad'")
  (constraint edge_clearance (min 0.91mm))
  (severity ignore)
)

(rule r2
  (condition "A.Type == 'Pad'")
  (constraint assertion "A.NetName == '/sub*'")
)

(rule r3
  (condition "A.Pad_Shape == 'Trapezoid'")
  (constraint track_width (min 0.18mm))
  (constraint assertion "A.memberOfFootprint('U6') || A.Reference == 'U1'")
)

(rule r4
  (condition "A.hasExactNetclass('Default')")
  (constraint assertion "A.insideCourtyard('U3')")
)
