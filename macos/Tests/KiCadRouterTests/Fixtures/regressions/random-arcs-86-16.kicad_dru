(version 1)

(rule r0
  (condition "B.Size_X > 80.3mil")
  (constraint clearance (min 0.37mm))
)

(rule r1
  (condition "!B.isPlated()")
  (constraint hole_to_hole (min 0.68mm))
)

(rule r2
  (layer F.Cu)
  (condition "A.Reference == '?7' || (A.Pad_Shape == 'R*' || L == 'B.Cu')")
  (constraint clearance (min 0.26mm))
  (constraint track_width (min 0.16mm) (max 0.37mm))
)
